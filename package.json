{
  "name": "scrabble",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:local": "bun scripts/dev-local.ts",
    "dev:server": "cargo run -p scrabble-server --locked",
    "dev:tls": "cargo run -p scrabble-server --example local_tls --locked",
    "format": "oxfmt . && cargo fmt --all",
    "format:check": "oxfmt --check . && cargo fmt --all --check",
    "lint": "oxlint --type-aware --tsconfig tsconfig.json apps/web scripts && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --workspace --all-targets --locked && bun test apps/web/src scripts",
    "build": "vite build --config apps/web/vite.config.ts",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run build && bun run test:browser",
    "test:browser": "bun scripts/test-browser.ts && bun scripts/test-browser.ts --pages",
    "test:deployment": "bun scripts/test-deployment.ts",
    "fixtures:generate": "cargo run -q -p scrabble-game --example public_fixtures --locked"
  },
  "dependencies": {
    "@moritzbrantner/ui": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsqr": "1.4.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "packageManager": "bun@1.4.2"
}
