{
  "name": "scrabble",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:server": "cargo run -p scrabble-server",
    "format": "oxfmt . && cargo fmt --all",
    "format:check": "oxfmt --check . && cargo fmt --all --check",
    "lint": "oxlint --type-aware --tsconfig tsconfig.json apps/web && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --workspace --locked && bun test apps/web",
    "build": "vite build --config apps/web/vite.config.ts",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@moritzbrantner/ui": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.0.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^5.9.3",
    "vite": "^8.0.8"
  },
  "packageManager": "bun@1.4.2"
}
