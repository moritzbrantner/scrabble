# Local defaults. Bun run loads .env; the Rust binary consumes process environment only.
SCRABBLE_MODE=local
SCRABBLE_PORT=4433
SCRABBLE_STATUS_PORT=8080
SCRABBLE_API_PORT=8081
# Exact browser origin allowed for creation/retirement. Production requires explicit HTTPS.
SCRABBLE_BOARD_ORIGIN=http://localhost:5173
SCRABBLE_CERT_PEM=.local/server/cert.pem
SCRABBLE_KEY_PEM=.local/server/key.pem
# Persistent PRIVATE 32-byte initialization key. Keep outside the consumed recovery bundle.
SCRABBLE_SEED_FILE=.local/server/seed
SCRABBLE_RECOVERY_DIR=.local/server/recovery
SCRABBLE_ROUTE_PREFIX=/game
# Set empty for a process that starts with zero matches.
SCRABBLE_MATCH_IDS=table-1,table-2
SCRABBLE_MAX_MATCHES=16
SCRABBLE_RECONNECT_GRACE_TICKS=1200
SCRABBLE_DRAIN_GRACE_MS=500
# Deterministic fixtures only: optional 64 hex characters, forbidden in production.
# SCRABBLE_TEST_SEED=
# Production requires explicit absolute TLS, seed and recovery paths, match IDs (possibly empty), and HTTPS board origin.
# Do not place private keys, seed bytes or reconnect tokens in VITE_* variables.
