SCRABBLE_MODE=production
SCRABBLE_PORT=443
SCRABBLE_STATUS_PORT=18080
SCRABBLE_API_PORT=18081
SCRABBLE_BOARD_ORIGIN=https://moritzbrantner.github.io
SCRABBLE_CERT_PEM=/run/credentials/scrabble-server.service/cert.pem
SCRABBLE_KEY_PEM=/run/credentials/scrabble-server.service/key.pem
SCRABBLE_SEED_FILE=/var/lib/scrabble/seed
SCRABBLE_RECOVERY_DIR=/var/lib/scrabble/recovery
SCRABBLE_BOARD_LAYOUT_DIR=/var/lib/scrabble/layouts
SCRABBLE_WORD_LIST_DIR=/var/lib/scrabble/word-lists
SCRABBLE_TILE_PROFILE_DIR=/var/lib/scrabble/tile-profiles
SCRABBLE_WORD_LIST_MAX_BYTES=1048576
SCRABBLE_WORD_LIST_MAX_WORDS=200000
SCRABBLE_WORD_LIST_MAX_LISTS=1024
SCRABBLE_WORD_LIST_MAX_VERSIONS=8
SCRABBLE_WORD_LIST_MAX_STORED_BYTES=268435456
SCRABBLE_ROUTE_PREFIX=/game
SCRABBLE_MATCH_IDS=
SCRABBLE_MAX_MATCHES=16
SCRABBLE_RECONNECT_GRACE_TICKS=72000
SCRABBLE_DRAIN_GRACE_MS=500
SCRABBLE_DICTIONARY_FILE=/opt/scrabble/content/words.txt
SCRABBLE_DICTIONARY_NAME=scowl-en-us-60
SCRABBLE_DICTIONARY_REVISION=2026.02.25-recipe1
